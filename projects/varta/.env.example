# Copy this file to .env on the mini-PC. Never commit real credentials.
# RTSP passwords containing @, #, : or / must be URL-encoded.
# Typical Hikvision main stream: rtsp://USER:PASSWORD@CAMERA_IP:554/Streaming/Channels/101
VARTA_CAM1_RTSP=
VARTA_CAM2_RTSP=
VARTA_CAM3_RTSP=
# Fill locally; not needed for the demo.
OPENAI_API_KEY=
# Required for access from the operator laptop. At least 16 characters.
VARTA_OPERATOR_TOKEN=
# Optional absolute FFmpeg path; bundled imageio-ffmpeg is used otherwise.
# VARTA_FFMPEG=
# Set to 1 only when serving over HTTPS behind a local reverse proxy.
# VARTA_SECURE_COOKIE=1
