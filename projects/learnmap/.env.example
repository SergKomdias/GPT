PORT=3100
APP_ORIGIN=http://127.0.0.1:5173
ENABLE_DEMO=true
# Leave empty to use the local, disk-persisted PostgreSQL engine.
DATABASE_URL=
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
# Required when ENABLE_DEMO=false to provision an administrator:
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pilot configuration (local demo defaults remain off for pilot)
PILOT_MODE=false
PILOT_INVITE_CODE=
SPEAKING_RETENTION_DAYS=30
PILOT_TIMEZONE=Europe/Kyiv
HOST=127.0.0.1
TRUST_PROXY=0
# Production: NODE_ENV=production, ENABLE_DEMO=false, external DATABASE_URL, HTTPS APP_ORIGIN.
